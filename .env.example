# Modelo de variáveis de ambiente — ESTE arquivo PODE ser commitado (sem valores reais).
# Copie para .env.local e preencha. Convenção Vite: prefixo VITE_ expõe ao frontend.

# Stripe (chave publicável — segura no frontend)
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Apenas servidor (NUNCA no frontend nem no repositório) ---
# Configurar via segredos da Edge Function (supabase secrets set), não aqui:
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET
#   SUPABASE_SERVICE_ROLE_KEY
